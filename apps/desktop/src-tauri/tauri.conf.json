{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keys Manager",
  "version": "0.1.0",
  "identifier": "com.keysmanager.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm --filter @clavis/web dev",
      "cwd": "../../.."
    },
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": {
      "script": "pnpm --filter @clavis/web build",
      "cwd": "../../.."
    },
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keys Manager",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
