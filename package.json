{
  "name": "clavis",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @clavis/desktop dev",
    "dev:web": "pnpm --filter @clavis/web dev",
    "dev:desktop": "pnpm --filter @clavis/desktop dev",
    "dev:mobile": "pnpm --filter @clavis/mobile android:dev",
    "dev:mobile:ios": "pnpm --filter @clavis/mobile ios:dev",
    "build": "pnpm --filter @clavis/desktop build",
    "build:web": "pnpm --filter @clavis/web build",
    "build:desktop": "pnpm --filter @clavis/desktop build",
    "build:mobile:android": "pnpm --filter @clavis/mobile android:build",
    "build:mobile:ios": "pnpm --filter @clavis/mobile ios:build",
    "mobile:android:init": "pnpm --filter @clavis/mobile android:init",
    "mobile:ios:init": "pnpm --filter @clavis/mobile ios:init",
    "signet:android": "bash scripts/signet-android-release.sh",
    "signet:ios": "bash scripts/signet-ios-release.sh",
    "signet:ios:fixture": "bash scripts/signet-ios-package-fixture.sh",
    "test:vault": "cargo test -p vault-core",
    "checksum": "node scripts/checksum-release.mjs",
    "tauri": "pnpm --filter @clavis/desktop exec tauri"
  }
}
